{
  "version": 1,
  "commands": [
    {"comment": "Set sequence dimensions; param1=width; param2=height", "op": "dims", "width": 320, "height": 200},
    {"comment": "Fade all to black; param1=fade time", "op": "fadeToBlack", "ms": 0},
    {"comment": "Set text fore color; 0xRRGGBB", "op": "textColor", "color": [255, 255, 255]},
    {"comment": "Set text back color; 0xRRGGBB", "op": "textBackColor", "color": [0, 0, 0]},
    {"comment": "Set text effect; Traced, None, others when added", "op": "textEffect", "effect": "traced"},
    {"comment": "Play music", "op": "music", "file": "base/cutscene/ending/victoryf.mod"},
    {"comment": "Set font to use", "op": "font", "resolution": "sd", "index": 0, "file": "base/fonts/slides.fon"},
    {"comment": "Set font to use", "op": "font", "resolution": "hd", "index": 0, "file": "addons/mm-hd/fonts/slides.fon"},
    {"comment": "Set ANIM to draw animation frames from", "op": "ani", "resolution": "sd", "file": "base/cutscene/ending/ending.ani.json"},
    {"comment": "Set ANIM to draw animation frames from", "op": "ani", "resolution": "hd", "file": "addons/mm-hd/cutscene/ending/ending.ani.json"},
    {"comment": "Set text vertical position; can be T=top, B=bottom, M=middle", "op": "textAlign", "align": "top"},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [12, 28, 120]},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 3000},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["When I awoke, there was an angel", "floating above me."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["I knew I was dead."]},
    {"comment": "Wait", "op": "wait", "ms": 2000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["But if one HAS to die, I thought", "to myself..."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...this was definitely the RIGHT", "way to be dead."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["That was about the time I heard", "Talana's voice..."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...telling me to stop babbling", "and listen for a moment."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["She told me that the escape pod", "had almost been torn in half."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["I had been unconscious for over", "three weeks..."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...but my crew and I had", "succeeded in our mission!"]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["The force of the explosion,", "amplified by the Chmmr", "crystals..."]},
    {"comment": "Wait", "op": "wait", "ms": 3500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...had been sufficient to", "vaporize the Sa-Matra!"]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["And following the destruction of", "the Sa-Matra battle platform..."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...the fleets of the Ur-Quan and", "the Kohr-Ah had fallen into", "chaos..."]},
    {"comment": "Wait", "op": "wait", "ms": 3500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...and had been vanquished by", "Chmmr forces and allied", "starships."]},
    {"comment": "Wait", "op": "wait", "ms": 3500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Then Talana told me to sit up."]},
    {"comment": "Wait", "op": "wait", "ms": 2000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["She said there was something she", "thought I'd like to see..."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Wait", "op": "wait", "ms": 700},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 700},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [112, 112, 112]},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 700},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["I pulled myself up and looked", "around..."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...I was in Sick Bay of the", "Starbase, looking out over", "Earth."]},
    {"comment": "Wait", "op": "wait", "ms": 4000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Beneath me throbbed the sick red", "glow of the Ur-Quan slave shield."]},
    {"comment": "Wait", "op": "wait", "ms": 3500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Talana smiled and said that for", "the past few days..."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["the Chmmr had been working on", "lowering the shield..."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["and that it should be neutralized", "right about... Now!"]},
    {"comment": "Wait", "op": "wait", "ms": 3500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 700},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToWhite", "ms": 700},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [112, 112, 112]},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 1200},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["With a flare of incandescent", "light, the slave shield", "vanished..."]},
    {"comment": "Wait", "op": "wait", "ms": 4500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...and for the first time in my", "life I saw the true colors of", "Earth..."]},
    {"comment": "Wait", "op": "wait", "ms": 4500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...blues and greens in a thousand", "different shades."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["As we watched, we could see the", "first signs of ships coming up", "from Earth."]},
    {"comment": "Wait", "op": "wait", "ms": 4000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["They lifted from the planet's", "surface to join us in space."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["The destiny of Mankind had been", "delayed for over twenty years..."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...but now our world was free", "and nothing could stop us!"]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["I stayed in that hospital for", "almost a month..."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...but that day..."]},
    {"comment": "Wait", "op": "wait", "ms": 2000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...that day I watched the shield", "fall and beautiful Talana stood", "at my side..."]},
    {"comment": "Wait", "op": "wait", "ms": 4500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["I'll never forget that day. Not", "for the rest of my life..."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Wait", "op": "wait", "ms": 700},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 700},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [252, 96, 0]},
    {"comment": "Clear screen", "op": "clearScreen"},
    {"comment": "Restore color", "op": "fadeToColor", "ms": 0},
    {"comment": "Wait a little", "op": "wait", "ms": 1000},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["But Grandfather then what", "happened?"]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Clear screen", "op": "clearScreen"},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Yeah! How did you get home?"]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Clear screen", "op": "clearScreen"},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["How long did it take before you", "and Grandma finally got married?"]},
    {"comment": "Wait", "op": "wait", "ms": 3500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Clear screen", "op": "clearScreen"},
    {"comment": "Wait", "op": "wait", "ms": 700},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 700},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [252, 96, 0]},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 3},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 700},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Oh, while we intended to come", "right home..."]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 3},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["...we got a little sidetracked."]},
    {"comment": "Wait", "op": "wait", "ms": 2500},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 3},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Talana and I didn't make it back", "here to Unzervalt until almost", "five years later."]},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 3},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["But Grandfather! What happened?", "Where did you go?"]},
    {"comment": "Wait", "op": "wait", "ms": 4000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 3},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["And how did you find the Mark II?"]},
    {"comment": "Wait", "op": "wait", "ms": 3000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 3},
    {"comment": "Wait", "op": "wait", "ms": 700},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 700},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [112, 112, 112]},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 4},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 700},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["That, my children, is an entirely", "different story."]},
    {"comment": "Wait", "op": "wait", "ms": 7000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 4},
    {"comment": "Wait", "op": "wait", "ms": 800},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 700}
  ]
}
