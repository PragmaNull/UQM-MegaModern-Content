{
  "version": 1,
  "strings": [
    {"id": "========== This is the PC ending slides script =====================", "text": [""]},
    {"id": " !!!WARNING!!! Do not mess with the timing of this script starting "},
    {"id": " from MUSIC opcode. The music is synchronized to the slides.       "},
    {"id": " If you MUST change timing of a subtitle, make sure this change is "},
    {"id": " balanced off by another subtitle within the same slide!           ", "text": [""]},
    {"id": "Set sequence dimensions; param1=width; param2=height", "text": ["DIMS 320 200"]},
    {"id": "Everything is drawn within the clipping rect defined by DIMS, from 0, 0", "text": [""]},
    {"id": "Fade all to black; param1=fade time", "text": ["FTB 0"]},
    {"id": "Set text fore color; 0xRRGGBB", "text": ["TC FFFFFF"]},
    {"id": "Set text back color; 0xRRGGBB", "text": ["TBC 000000"]},
    {"id": "Set text effect; Traced, None, others when added", "text": ["TE TRACED"]},
    {"id": "Play music", "text": ["MUSIC base/cutscene/ending/victoryf.mod"]},
    {"id": "************* Slides *********************************************", "text": [""]},
    {"id": "Set font to use", "text": ["FONT1X 0 base/fonts/slides.fon"]},
    {"id": "Set font to use", "text": ["FONT4X 0 addons/mm-hd/fonts/slides.fon"]},
    {"id": "Set ANIM to draw animation frames from", "text": ["ANI1X base/cutscene/ending/ending.ani.json"]},
    {"id": "Set ANIM to draw animation frames from", "text": ["ANI4X addons/mm-hd/cutscene/ending/ending.ani.json"]},
    {"id": "Set text vertical position; can be T=top, B=bottom, M=middle", "text": ["TVA T"]},
    {"id": "++++++++++++++++++++ Slide 1 ++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 0C1C78"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 3000"]},
    {"id": "Text fade-in", "text": ["TFI When I awoke, there was an angel", "floating above me."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI I knew I was dead."]},
    {"id": "Wait", "text": ["WAIT 2000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI But if one HAS to die, I thought", "to myself..."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...this was definitely the RIGHT", "way to be dead."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI That was about the time I heard", "Talana's voice..."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...telling me to stop babbling", "and listen for a moment."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI She told me that the escape pod", "had almost been torn in half."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI I had been unconscious for over", "three weeks..."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...but my crew and I had", "succeeded in our mission!"]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI The force of the explosion,", "amplified by the Chmmr", "crystals..."]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...had been sufficient to", "vaporize the Sa-Matra!"]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI And following the destruction of", "the Sa-Matra battle platform..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...the fleets of the Ur-Quan and", "the Kohr-Ah had fallen into", "chaos..."]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...and had been vanquished by", "Chmmr forces and allied", "starships."]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Then Talana told me to sit up."]},
    {"id": "Wait", "text": ["WAIT 2000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI She said there was something she", "thought I'd like to see..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++ Slide 2 ++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 707070"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI I pulled myself up and looked", "around..."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...I was in Sick Bay of the", "Starbase, looking out over", "Earth."]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Beneath me throbbed the sick red", "glow of the Ur-Quan slave shield."]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Talana smiled and said that for", "the past few days..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI the Chmmr had been working on", "lowering the shield..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI and that it should be neutralized", "right about... Now!"]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTW 700"]},
    {"id": "+++++++++++++++++++++++ Slide 3 +++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 707070"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 1200"]},
    {"id": "Text fade-in", "text": ["TFI With a flare of incandescent", "light, the slave shield", "vanished..."]},
    {"id": "Wait", "text": ["WAIT 4500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...and for the first time in my", "life I saw the true colors of", "Earth..."]},
    {"id": "Wait", "text": ["WAIT 4500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...blues and greens in a thousand", "different shades."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI As we watched, we could see the", "first signs of ships coming up", "from Earth."]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI They lifted from the planet's", "surface to join us in space."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI The destiny of Mankind had been", "delayed for over twenty years..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...but now our world was free", "and nothing could stop us!"]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI I stayed in that hospital for", "almost a month..."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...but that day..."]},
    {"id": "Wait", "text": ["WAIT 2000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...that day I watched the shield", "fall and beautiful Talana stood", "at my side..."]},
    {"id": "Wait", "text": ["WAIT 4500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI I'll never forget that day. Not", "for the rest of my life..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++++ Slide 4 +++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC FC6000"]},
    {"id": "Clear screen", "text": ["CLS"]},
    {"id": "Restore color", "text": ["FTC 0"]},
    {"id": "Wait a little", "text": ["WAIT 1000"]},
    {"id": "Text fade-in", "text": ["TFI But Grandfather then what", "happened?"]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Clear screen", "text": ["CLS"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Yeah! How did you get home?"]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Clear screen", "text": ["CLS"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI How long did it take before you", "and Grandma finally got married?"]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Clear screen", "text": ["CLS"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++++ Slide 5 +++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC FC6000"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI Oh, while we intended to come", "right home..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...we got a little sidetracked."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Talana and I didn't make it back", "here to Unzervalt until almost", "five years later."]},
    {"id": "Wait", "text": ["WAIT 5000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI But Grandfather! What happened?", "Where did you go?"]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI And how did you find the Mark II?"]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++++ Slide 6 +++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 707070"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI That, my children, is an entirely", "different story."]},
    {"id": "Wait", "text": ["WAIT 7000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Wait", "text": ["WAIT 800"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "***************************** The End ********************************", "text": [""]}
  ]
}
