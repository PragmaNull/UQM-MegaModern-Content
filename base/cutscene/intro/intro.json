{
  "version": 1,
  "strings": [
    {"id": "=========== This is the PC intro script =========================", "text": [""]},
    {"id": " !!!WARNING!!! Do not mess with the timing of this script starting "},
    {"id": " from SYNC in Slide 1. The music is synchronized to the slides. If "},
    {"id": " you MUST change timing of a subtitle, make sure this change is    "},
    {"id": " balanced off by another subtitle within the same slide!           ", "text": [""]},
    {"id": "Clear entire screen first; set size...", "text": ["DIMS 320 240"]},
    {"id": "... and clear", "text": ["CLS"]},
    {"id": "Set sequence dimensions; param1=width; param2=height", "text": ["DIMS 320 200"]},
    {"id": "Everything is drawn within the clipping rect defined by DIMS, from 0, 0", "text": [""]},
    {"id": "Fade all to black; param1=fade time", "text": ["FTB 0"]},
    {"id": "Set text fore color; 0xRRGGBB", "text": ["TC FFFFFF"]},
    {"id": "Set text back color; 0xRRGGBB", "text": ["TBC 000000"]},
    {"id": "Set text effect; Traced, None, others when added", "text": ["TE TRACED"]},
    {"id": "Load font to use later", "text": ["FONT1X 0 base/fonts/starcon.fon"]},
    {"id": "Load font to use later", "text": ["FONT1X 1 base/fonts/slides.fon"]},
    {"id": "Load font to use later", "text": ["FONT4X 0 addons/mm-hd/fonts/starcon.fon"]},
    {"id": "Load font to use later", "text": ["FONT4X 1 addons/mm-hd/fonts/slides.fon"]},
    {"id": "************ Title Screen ******************************************", "text": [""]},
    {"id": "+++++++++++ Title 1 +++++++++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set font to use", "text": ["FONT 0"]},
    {"id": "Set ANIM to draw slides from", "text": ["ANI1X base/cutscene/intro/title.ani.json"]},
    {"id": "Set ANIM to draw slides from", "text": ["ANI4X addons/mm-hd/cutscene/intro/title.ani.json"]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 000000"]},
    {"id": "Set text vertical position; can be T=top, B=bottom, M=middle", "text": ["TVA B"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 1500"]},
    {"id": "Wait", "text": ["WAIT 2000"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 2000"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "++++++++++++ Title 2 +++++++++++++++++++++++++++++++++++", "text": [""]},
    {"id": "Play music", "text": ["MUSIC base/cutscene/intro/introx.mod"]},
    {"id": "Move sync point to current time index", "text": ["RESYNC"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 3000"]},
    {"id": "Synchronize", "text": ["SYNC 5000"]},
    {"id": "Text fade-in", "text": ["TFI Based on the source code of STAR CONTROL II", "(All trademarks belong to their respective owners)"]},
    {"id": "Synchronize", "text": ["SYNC 8000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Wait", "text": ["WAIT 200"]},
    {"id": "Text fade-in", "text": ["TFI Originally Created by", "Fred Ford and Paul Reiche III", "in 1992"]},
    {"id": "Synchronize", "text": ["SYNC 12000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Wait", "text": ["WAIT 200"]},
    {"id": "Text fade-in", "text": ["TFI Set free into the Open Source community", "in 2002"]},
    {"id": "Synchronize", "text": ["SYNC 16000"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 3000"]},
    {"id": "************* Slides *********************************************", "text": [""]},
    {"id": "Set font to use", "text": ["FONT 1"]},
    {"id": "Set ANIM to draw slides from", "text": ["ANI base/cutscene/intro/intro.ani.json"]},
    {"id": "Set ANIM to draw slides from", "text": ["ANI4X addons/mm-hd/cutscene/intro/intro.ani.json"]},
    {"id": "Set text vertical position; can be T=top, B=bottom, M=middle", "text": ["TVA T"]},
    {"id": "++++++++++++++++++++ Slide 1 ++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 1018BC"]},
    {"id": "!!! Milestone Sync 1 !!!", "text": ["SYNC 20000"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI There were many great battles..."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Earth and her partners in the", "Alliance of Free Stars..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Against the evil Ur-Quan and its", "Hierarchy of Battle Thralls."]},
    {"id": "!!! Milestone Sync 2 !!!", "text": ["SYNC 35000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI ...and the Ur-Quan were winning..."]},
    {"id": "Wait", "text": ["WAIT 2000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Meanwhile, on the edge of the", "known frontier, an amazing", "discovery was made..."]},
    {"id": "!!! Milestone Sync 3 !!!", "text": ["SYNC 41000"]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI far beneath the surface of an", "unexplored, alien world..."]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++ Slide 2 ++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 707070"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI A huge underground city..."]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Filled with the technological", "wonders of an advanced alien", "race, the Precursors..."]},
    {"id": "Wait", "text": ["WAIT 6000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Who vanished a thousand", "centuries ago."]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI But then the main Ur-Quan fleet", "broke through the Alliance's", "defensive line..."]},
    {"id": "Wait", "text": ["WAIT 6500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Isolating the planet, stranding", "the scientists a hundred light", "years away from Earth."]},
    {"id": "Wait", "text": ["WAIT 6500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI They waited hopefully for a", "rescue vessel..."]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI which never came."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 1"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++++ Slide 3 +++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC FCA030"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI 20 years have passed..."]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI We, the survivors of the research", "mission have colonized this world."]},
    {"id": "Wait", "text": ["WAIT 4500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI We continued our investigation of", "the underground city..."]},
    {"id": "Wait", "text": ["WAIT 4500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI And we have discovered its", "purpose..."]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI It is a factory. "]},
    {"id": "Wait", "text": ["WAIT 3000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 2"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++++ Slide 4 +++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC FC480C"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI A factory for building starships!"]},
    {"id": "Wait", "text": ["WAIT 4500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI But there aren't enough materials", "to make a complete vessel."]},
    {"id": "Wait", "text": ["WAIT 5000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI We can finish only the skeleton", "of one starship."]},
    {"id": "Wait", "text": ["WAIT 5000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI But that must be enough --"]},
    {"id": "Wait", "text": ["WAIT 3500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Because YOU must captain the", "vessel..."]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI And return to Earth!"]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 3"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "+++++++++++++++++++++++ Slide 5 +++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 000000"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 700"]},
    {"id": "Text fade-in", "text": ["TFI To travel the great distance,", "you must push through into", "HyperSpace..."]},
    {"id": "Wait", "text": ["WAIT 6000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Find out what has happened over", "these many years..."]},
    {"id": "Wait", "text": ["WAIT 5000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Tell Earth of our plight!"]},
    {"id": "Wait", "text": ["WAIT 4000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI And if the war with the Ur-Quan", "still rages..."]},
    {"id": "Wait", "text": ["WAIT 5000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Wait", "text": ["WAIT 500"]},
    {"id": "Text fade-in", "text": ["TFI Fight for Earth and the Alliance,", "as well as you can..."]},
    {"id": "Wait", "text": ["WAIT 6000"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 4"]},
    {"id": "Wait", "text": ["WAIT 700"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 700"]},
    {"id": "***************************** The End ********************************", "text": [""]}
  ]
}
