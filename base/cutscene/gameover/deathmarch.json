{
  "version": 1,
  "commands": [
    {"comment": "Clear entire screen first; set size...", "op": "dims", "width": 320, "height": 240},
    {"comment": "... and clear", "op": "clearScreen"},
    {"comment": "Set sequence dimensions; param1=width; param2=height", "op": "dims", "width": 320, "height": 200},
    {"comment": "Fade all to black; param1=fade time", "op": "fadeToBlack", "ms": 0},
    {"comment": "Set text fore color; 0xRRGGBB", "op": "textColor", "color": [255, 255, 255]},
    {"comment": "Set text back color; 0xRRGGBB", "op": "textBackColor", "color": [0, 0, 0]},
    {"comment": "Set text effect; Traced, None, others when added", "op": "textEffect", "effect": "traced"},
    {"comment": "Load font to use later", "op": "font", "resolution": "sd", "index": 0, "file": "base/fonts/starcon.fon"},
    {"comment": "Load font to use later", "op": "font", "resolution": "sd", "index": 1, "file": "base/fonts/slides.fon"},
    {"comment": "Load font to use later", "op": "font", "resolution": "hd", "index": 0, "file": "addons/mm-hd/fonts/player.fon"},
    {"comment": "Load font to use later", "op": "font", "resolution": "hd", "index": 1, "file": "addons/mm-hd/fonts/slides.fon"},
    {"comment": "Set font to use", "op": "font", "index": 0},
    {"comment": "Set ANIM to draw slides from", "op": "ani", "resolution": "sd", "file": "base/cutscene/gameover/gameover.ani.json"},
    {"comment": "Set ANIM to draw slides from", "op": "ani", "resolution": "hd", "file": "addons/mm-hd/cutscene/gameover/gameover.ani.json"},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [136, 0, 0]},
    {"comment": "Set text vertical position; can be T=top, B=bottom, M=middle", "op": "textAlign", "align": "bottom"},
    {"comment": "Play music", "op": "music", "file": "base/cutscene/gameover/deathmarch.ogg"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 1500},
    {"comment": "Wait", "op": "wait", "ms": 2000},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 2000},
    {"comment": "Move sync point to current time index", "op": "resync"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 3000},
    {"comment": "Synchronize", "op": "sync", "ms": 3000},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["The Kohr-Ah Primat stares at the ignition key,", "talons dangling mere inches from", "Earth's certain doom."]},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["This would be it.", "", "The end of the crusade."]},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["This wasn't just Earth's end, this wasn't", "just the end of the New Alliance."]},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["The Kzer-Za could no longer intervene.", "The Captain could no longer stand against the might", "of the Kohr-Ah."]},
    {"comment": "Wait", "op": "wait", "ms": 9000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["But it would be the end of the Doctrinal War.", "After cleansing this filth, the Doctrine's purpose", "will be fulfilled... At least for another millennia."]},
    {"comment": "Wait", "op": "wait", "ms": 9000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 200},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["When new sentience emerges from worlds", "unknown, she hoped that her progeny", "would take up the mantle."]},
    {"comment": "Wait", "op": "wait", "ms": 9000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 200},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Eliminating future threats to the", "freedom of the Ur-Quan."]},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Wait", "op": "wait", "ms": 200},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["They would not understand.", "", "This has to be done."]},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 1},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 2000},
    {"comment": "Set text vertical position; can be T=top, B=bottom, M=middle", "op": "textAlign", "align": "middle"},
    {"comment": "Set font to use", "op": "font", "index": 1},
    {"comment": "Set text fade in/out color; 0xRRGGBB", "op": "textFadeColor", "color": [0, 0, 0]},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 1500},
    {"comment": "Text fade-in", "op": "textFadeIn", "lines": ["Forever."]},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Text fade-out", "op": "textFadeOut"},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 2},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 2000},
    {"comment": "Draw slide; param1=ANI index", "op": "draw", "frame": 0},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 3000},
    {"comment": "Wait", "op": "wait", "ms": 5000},
    {"comment": "Fade slide to black; param1=fade time", "op": "fadeToBlack", "ms": 5000}
  ]
}
