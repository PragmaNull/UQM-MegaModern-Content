{
  "version": 1,
  "strings": [
    {"id": "=========== This is the PC intro script =========================", "text": [""]},
    {"id": " !!!WARNING!!! Do not mess with the timing of this script starting "},
    {"id": " from SYNC in Slide 1. The music is synchronized to the slides. If "},
    {"id": " you MUST change timing of a subtitle, make sure this change is    "},
    {"id": " balanced off by another subtitle within the same slide!           ", "text": [""]},
    {"id": "Clear entire screen first; set size...", "text": ["DIMS 320 240"]},
    {"id": "... and clear", "text": ["CLS"]},
    {"id": "Set sequence dimensions; param1=width; param2=height", "text": ["DIMS 320 200"]},
    {"id": "Everything is drawn within the clipping rect defined by DIMS, from 0, 0", "text": [""]},
    {"id": "Fade all to black; param1=fade time", "text": ["FTB 0"]},
    {"id": "Set text fore color; 0xRRGGBB", "text": ["TC FFFFFF"]},
    {"id": "Set text back color; 0xRRGGBB", "text": ["TBC 000000"]},
    {"id": "Set text effect; Traced, None, others when added", "text": ["TE TRACED"]},
    {"id": "Load font to use later", "text": ["FONT1X 0 base/fonts/starcon.fon"]},
    {"id": "Load font to use later", "text": ["FONT1X 1 base/fonts/slides.fon"]},
    {"id": "Load font to use later", "text": ["FONT4X 0 addons/mm-hd/fonts/player.fon"]},
    {"id": "Load font to use later", "text": ["FONT4X 1 addons/mm-hd/fonts/slides.fon"]},
    {"id": "************ Title Screen ******************************************", "text": [""]},
    {"id": "+++++++++++ Title 1 +++++++++++++++++++++++++++++++++", "text": [""]},
    {"id": "Set font to use", "text": ["FONT 0"]},
    {"id": "Set ANIM to draw slides from", "text": ["ANI1X base/cutscene/gameover/gameover.ani.json"]},
    {"id": "Set ANIM to draw slides from", "text": ["ANI4X addons/mm-hd/cutscene/gameover/gameover.ani.json"]},
    {"id": "Set text fade in/out color; 0xRRGGBB", "text": ["TFC 880000"]},
    {"id": "Set text vertical position; can be T=top, B=bottom, M=middle", "text": ["TVA B"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Fade-in a slide; param1=fade time", "text": ["FTC 2500"]},
    {"id": "Text fade-in", "text": ["TFI Better luck next time."]},
    {"id": "Wait", "text": ["WAIT 2500"]},
    {"id": "Text fade-out", "text": ["TFO"]},
    {"id": "Draw slide; param1=ANI index", "text": ["DRAW 0"]},
    {"id": "Fade slide to black; param1=fade time", "text": ["FTB 2500"]},
    {"id": "***************************** The End ********************************", "text": [""]}
  ]
}
