{
  "version": 1,
  "commands": [
    {"comment": "Clear entire screen first; set size...", "op": "dims", "width": 320, "height": 200},
    {"comment": "Load font to use later", "op": "font", "resolution": "sd", "index": 0, "file": "base/fonts/micro.thin.fon"},
    {"comment": "Load font to use later", "op": "font", "resolution": "hd", "index": 0, "file": "addons/mm-hd/fonts/micro.thin.fon"},
    {"comment": "Set color", "op": "textColor", "color": [85, 255, 85]},
    {"comment": "Set color", "op": "textBackColor", "color": [255, 255, 255]},
    {"comment": "Load movie", "op": "ani", "resolution": "sd", "file": "addons/dos-mode-sd/cutscene/spins/accessdata.ani.json"},
    {"comment": "Load movie", "op": "ani", "resolution": "hd", "file": "addons/dos-mode-hd/cutscene/spins/accessdata.ani.json"},
    {"comment": "Set font to use", "op": "font", "index": 0},
    {"comment": "Draw first frame", "op": "draw", "frame": 0},
    {"comment": "Fade-in a slide; param1=fade time", "op": "fadeToColor", "ms": 500},
    {"comment": "Text for spin", "op": "textSpin", "x": 68, "y": 53, "text": " Accessing Starship Databank..."},
    {"comment": "Wait", "op": "wait", "ms": 1600}
  ]
}
